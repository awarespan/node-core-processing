# =============================================================================
# AWARESPAN — LOCAL NODE CONFIGURATION
# Copy to .env. The setup wizard creates it automatically when missing.
# Keep .env private (0600); commit only this placeholder template.
# Sections are grouped by subsystem; all components load this one file.
# =============================================================================

# =============================================================================
# COMMON — node identity, runtime paths and shared behaviour
# =============================================================================
# Backend-owned values; leave blank. The runtime fills these after enrollment.
PI_NODE_ID=
AWARESPAN_STATE_DIR=/var/lib/awarespan
AWARESPAN_LOCK_FILE=/tmp/awarespan-update.lock
RUNTIME_HOST=0.0.0.0
RUNTIME_PORT=8766
LOG_LEVEL=INFO
LOG_DIR=/var/log/awarespan

# =============================================================================
# BACKEND — REST API authentication and incident synchronisation
# =============================================================================
BACKEND_API_URL=https://api.awarespan.bchbenjamin.in/
BACKEND_API_KEY=
# Backend-issued per-node credential; do not set manually.
PI_DEVICE_SECRET=
ALERT_WEBHOOK_URL=

# =============================================================================
# ML — model deployment, datasets and workstation-only training
# =============================================================================
ML_DEPLOYMENT_PROFILE=pi5_edge
ML_DEPLOYMENT_MANIFEST=models/deployed/manifest.json
ML_DEFAULT_MODEL=shared/models/yolov8n_best_weapon.pt
ML_TRAINING_ENABLED=false
ML_DATASET_DIR=datasets
ML_CHECKPOINT_DIR=models/working/training_runs

# =============================================================================
# TELEGRAM — optional interactive operator bot and notification queue
# =============================================================================
# Create a dedicated AWARESPAN bot with BotFather. Do not reuse another app's token.
BOT_TOKEN=
PRIMARY_CHAT_ID=
# Comma-separated numeric chat IDs allowed to operate the bot.
ALLOWED_CHAT_IDS=
TELEGRAM_QUEUE_PATH=/tmp/awarespan_telegram_queue.db

# =============================================================================
# MQTT — optional broker connectivity (independent of BACKEND_API_KEY)
# =============================================================================
MQTT_BROKER_URL=
MQTT_CLIENT_ID=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
MQTT_TLS_CA_CERT=
MQTT_TLS_INSECURE=false

# =============================================================================
# ALERTING & THREAT POLICY — inference thresholds and local queue storage
# =============================================================================
CONFIDENCE_THRESHOLD=0.45
COOLDOWN_SECONDS=8
OFFLINE_QUEUE_PATH=/tmp/awarespan_event_queue.db
INCIDENT_DB_PATH=/tmp/awarespan_event_queue.db

# =============================================================================
# DETERRENCE — speaker/siren outputs remain disabled until hardware is verified
# =============================================================================
SPEAKER_ENABLED=false
SIREN_ENABLED=false
PRESENCE_DETERRENCE_ENABLED=false
DETERRENCE_TARGET_LABELS=person
SPEAKER_DEVICE=default
DETERRENCE_STATE_FILE=/var/lib/awarespan/deterrence_state.json
DETERRENCE_FREQUENCY_MIN_HZ=900
DETERRENCE_FREQUENCY_MAX_HZ=1100
DETERRENCE_DURATION_SEC=1.5
DETERRENCE_OUTPUT_AMPLITUDE=0.08
DETERRENCE_COOLDOWN_SEC=30
SIREN_FILE=/var/lib/awarespan/audio/presence_warning.wav

# =============================================================================
# VOLUNTEER GATEWAY & ACCESS POINT — local media intake and field networking
# =============================================================================
VOLUNTEER_GATEWAY_ENABLED=true
VOLUNTEER_GATEWAY_HOST=0.0.0.0
VOLUNTEER_GATEWAY_PORT=8443
# Default to plain HTTP for trusted LAN/local testing. The gateway's generated
# self-signed certificate is not trusted by browser camera/microphone contexts.
# For a hosted portal, terminate TLS with a trusted reverse proxy/tunnel.
VOLUNTEER_GATEWAY_TLS=false
VOLUNTEER_MAX_SESSIONS=5
VOLUNTEER_MAX_CAMERAS=2
VOLUNTEER_MAX_MICROPHONES=2
VOLUNTEER_PAIRING_TIMEOUT_SEC=300
VOLUNTEER_HEARTBEAT_TIMEOUT_SEC=30
VOLUNTEER_PORTAL_STATIC_DIR=static/volunteer
AP_SSID=AWARESPAN-AP
AP_GATEWAY_IP=192.168.4.1

# =============================================================================
# OPERATOR AUTH — TOTP settings and secret persistence
# =============================================================================
TOTP_SECRET=
TOTP_ISSUER=AWARESPAN
TOTP_ACCOUNT_NAME=operator
TOTP_SECRET_FILE=/var/lib/awarespan/totp_secret.json
TOTP_WINDOW=1

# =============================================================================
# REMOTE CONNECTIVITY — tunnels, WebRTC and TURN relay credentials
# =============================================================================
REMOTE_CONNECTIVITY_ENABLED=true
TUNNEL_TYPE=tailscale
REMOTE_TUNNEL_URL=
WEBRTC_ENABLED=true
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# =============================================================================
# UPDATER — controlled repository update behaviour
# =============================================================================
AWARESPAN_UPDATE_BRANCH=main
AWARESPAN_UPDATE_CHECK_INTERVAL=120
AWARESPAN_REPO_URL=https://github.com/awarespan/node-core-processing.git
AWARESPAN_AUTO_UPDATE_ENABLED=false
