# ─── AWARESPAN Edge Node Configuration Template ──────────────────────────────
# Project: AWARESPAN
# Tagline: Awareness Without Boundaries.
# Official problem statement: An AI-Powered Safety Device.
# Contact: awarespan@bchbenjamin.in
#
# Copy this file to .env and configure local secrets.
# NEVER commit .env to Git or expose credentials in logs or commits.

# ─── Backend REST API ──────────────────────────────────────────────────────────
# Base URL for the AWARESPAN backend API
BACKEND_API_URL=https://api.awarespan.bchbenjamin.in/
# Shared secret / device API key for node authentication
BACKEND_API_KEY=

# ─── Node Identity ──────────────────────────────────────────────────────────
# Unique node identifier across the mesh / fleet
PI_NODE_ID=sip-pi-001
# Device secret used to verify heartbeat signatures and incident payloads
PI_DEVICE_SECRET=

# ─── MQTT Broker ─────────────────────────────────────────────────────────────
# Broker URL (e.g. tcp://broker.hivemq.com:1883 or ssl://your-broker:8883)
MQTT_BROKER_URL=tcp://broker.hivemq.com:1883
MQTT_CLIENT_ID=sip-pi-001
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
MQTT_TLS_CA_CERT=
MQTT_TLS_INSECURE=false

# ─── Telegram Bot & Notifications (Optional) ────────────────────────────────
# Bot token issued by BotFather
BOT_TOKEN=
# Primary admin chat ID for priority alerts
PRIMARY_CHAT_ID=
# Comma-separated list of authorised Telegram chat IDs
ALLOWED_CHAT_IDS=

# ─── Alert Webhook (Optional Fallback) ───────────────────────────────────────
ALERT_WEBHOOK_URL=

# ─── Volunteer Media Gateway & Local Hotspot ──────────────────────────────────
# Gateway HTTP/WebSocket binding
VOLUNTEER_GATEWAY_PORT=8443
VOLUNTEER_GATEWAY_HOST=0.0.0.0
VOLUNTEER_GATEWAY_TLS=true
# Static build directory for volunteer portal (falls back to embedded portal if empty)
VOLUNTEER_PORTAL_STATIC_DIR=
# Local Access Point IP when operating in field hotspot mode
AP_GATEWAY_IP=192.168.4.1

# ─── Operator TOTP Authentication (RFC 6238) ──────────────────────────────────
# Base32 secret key. If left blank, automatically generated & persisted securely.
TOTP_SECRET=
TOTP_ISSUER=AWARESPAN
TOTP_ACCOUNT_NAME=operator
TOTP_SECRET_FILE=/var/lib/awarespan/totp_secret.json
TOTP_WINDOW=1

# ─── Remote Ingress, Tunneling & WebRTC ────────────────────────────────────────
# Enable remote volunteer access across NAT/firewalls
REMOTE_CONNECTIVITY_ENABLED=true
# Tunnel provider: "tailscale", "cloudflared", "custom_https", or "disabled"
TUNNEL_TYPE=tailscale
# Remote ingress URL (auto-detected if using Tailscale Funnel / cloudflared, or explicit)
REMOTE_TUNNEL_URL=
# WebRTC low-latency streaming
WEBRTC_ENABLED=true
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
