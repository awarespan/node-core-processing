[Unit]
Description=AWARESPAN Temporary Optional Interactive Telegram Bot
Documentation=https://github.com/awarespan/node-core-processing
After=network-online.target awarespan-node.service
Wants=network-online.target

[Service]
Type=simple
User=%USER%
WorkingDirectory=%WORKDIR%
Environment=AWARESPAN_ENV_FILE=%ENV_FILE%
ExecStart=%PYTHON% -m pi.telegram_bot.bot
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
UMask=0077
StandardOutput=journal
StandardError=journal
Nice=10

[Install]
WantedBy=multi-user.target
