[Unit]
Description=AWARESPAN Power and Thermal Safety Monitor
Documentation=https://github.com/awarespan/node-core-processing
After=network-online.target

[Service]
Type=simple
User=%USER%
WorkingDirectory=%WORKDIR%
ExecStart=%PYTHON% -m node_runtime.monitoring.power_monitor
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
