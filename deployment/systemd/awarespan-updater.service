[Unit]
Description=AWARESPAN Edge Node Auto-Updater
Documentation=https://github.com/awarespan/node-core-processing
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=%USER%
WorkingDirectory=%WORKDIR%
ExecStart=%PYTHON% -m node_manager.cli check-and-update
StandardOutput=journal
StandardError=journal
